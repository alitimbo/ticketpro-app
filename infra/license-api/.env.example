LICENSE_BIND=0.0.0.0
LICENSE_PORT=8787
LICENSE_DB=/data/licenses.sqlite
# Manifeste public lu par l'Updater Tauri. Le fichier reste dans le volume /data.
APP_UPDATE_MANIFEST_PATH=/data/app-updates/stable.json
LICENSE_MASTER_TOKEN=replace-with-a-long-random-admin-token
LICENSE_HASH_SECRET=replace-with-a-different-long-random-hmac-secret
# 32 octets aléatoires en base64. Sauvegarder cette clé hors du VPS : sa perte
# rend les identifiants RouterOS du coffre définitivement illisibles.
ROUTER_VAULT_KEY=replace-with-openssl-rand-base64-32
# Clé distincte de 32 octets en base64 pour les archives de réimpression.
# Sa perte rend les mots de passe des archives historiques illisibles.
TICKET_ARCHIVE_KEY=replace-with-another-openssl-rand-base64-32
LICENSE_MAX_BODY_BYTES=262144
# Utilisé uniquement pour le premier seed. Changement obligatoire à la connexion.
LICENSE_DEFAULT_ADMIN_PASSWORD=admin123
# iPay Niger — secrets disponibles uniquement sur le VPS.
IPAY_BASE_URL=https://api.i-pay.money
IPAY_ENV=disabled
IPAY_PUBLIC_KEY=
IPAY_PRIVATE_KEY=
IPAY_SECRET_HASH=
# Réinitialisation des mots de passe SaaS via le SMTP LWS.
SAAS_PASSWORD_RESET_URL=https://www.ticketpro-ne.com/reset-password
SAAS_INVITATION_URL=https://www.ticketpro-ne.com/accept-invitation
SAAS_INVITATION_TTL_HOURS=24
# Vérification obligatoire de l'email avant tout essai ou paiement SaaS.
# Le code est HMAC côté serveur, jamais stocké ni journalisé en clair.
SAAS_EMAIL_VERIFICATION_TTL_MINUTES=10
SAAS_EMAIL_VERIFICATION_MAX_ATTEMPTS=5
SAAS_EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
SAAS_EMAIL_VERIFICATION_MAX_SENDS_PER_HOUR=3
# Destination des boutons de renouvellement et de conversion des emails automatiques.
SAAS_SUBSCRIPTION_URL=https://www.ticketpro-ne.com/
SMTP_HOST=mail.votre-domaine.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@votre-domaine.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=contact@votre-domaine.com
SMTP_FROM_NAME=TicketPro
# Uniquement en développement/test. Ne jamais activer en production.
SAAS_EXPOSE_RESET_TOKEN=false
# Tests automatisés uniquement : ne jamais activer en production.
SAAS_EXPOSE_EMAIL_VERIFICATION_CODE=false
# À placer derrière le reverse-proxy HTTPS de production.
LICENSE_CORS_ORIGIN=http://tauri.localhost,http://localhost:1420,http://localhost:4321,http://127.0.0.1:4321,http://localhost:4322,http://127.0.0.1:4322,https://ticketpro-ne.com,https://www.ticketpro-ne.com
# Relais interne vers WireGuard. Le token doit être identique à HUB_MASTER_TOKEN.
VPN_HUB_URL=http://127.0.0.1:8788
VPN_HUB_MASTER_TOKEN=replace-with-the-same-wireguard-hub-master-token
# Route de gestion stable sur chaque poste. L'isolation entre organisations
# reste appliquée par le pare-feu du hub ; ne jamais utiliser 0.0.0.0/0 ici.
VPN_CLIENT_ALLOWED_IPS=10.250.0.0/16
