{
  "name": "ticketpro",
  "description": "Gestion locale et distante de hotspots MikroTik",
  "private": true,
  "version": "0.6.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "lab:baseline": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-lab-baseline.ps1",
    "lab:sprint5:vouchers": "tsx scripts/benchmark-voucher-load.ts 1000 5000",
    "lab:sprint5": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-sprint5-gate.ps1",
    "preview": "vite preview",
    "test": "vitest run",
    "test:license-api": "node --test infra/license-api/subscription-notification-policy.node-test.mjs infra/license-api/organization-device-limit.node-test.mjs infra/license-api/server.integration.mjs infra/wireguard-hub/peer-lifecycle.node-test.mjs infra/wireguard-hub/tenant-firewall.node-test.mjs",
    "type-check": "tsc --noEmit",
    "vpn:components:check": "node scripts/check-wireguard-components.mjs",
    "version:set": "node scripts/set-version.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "release:check:windows": "node scripts/check-windows-release.mjs",
    "release:manifest:windows": "node scripts/create-windows-update-manifest.mjs",
    "tauri:build:windows": "npm run release:check:windows && node scripts/build-windows.mjs && node scripts/rename-windows-installer.mjs",
    "release:build:windows": "npm test && npm run type-check && npm run test:license-api && cargo check --manifest-path src-tauri/Cargo.toml && npm run tauri:build:windows"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^1.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.18",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "vite": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
