{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TicketPro",
  "mainBinaryName": "TicketPro",
  "version": "0.3.8",
  "identifier": "solutions.akicorp.ticketpro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TicketPro par Akicorp Solutions",
        "width": 1200,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* https:; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Akicorp Solutions",
    "copyright": "Copyright © 2026 Akicorp Solutions",
    "category": "Business",
    "shortDescription": "Gestion locale et distante de hotspots MikroTik",
    "longDescription": "TicketPro par Akicorp Solutions permet la gestion locale et distante de hotspots MikroTik.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/ticketpro-vpn-hooks.nsh",
        "languages": [
          "French"
        ],
        "startMenuFolder": "Akicorp Solutions"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://api.ticketpro-ne.com/v1/app-updates/check?target={{target}}&arch={{arch}}&current_version={{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5Mjc2OTUyMUY3RUY3RQpSV1IrNy9jaGxYYVNDcS9MZURUbVhlMG9kTURjbktWUmFHdmJPcTJOanp1RmNCc1JGZXBOK3doRwo=",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
